<?xml version="1.0" encoding="utf-8"?>
<!-- The screensaver: the backdrop darkened at the bottom and at the left, where the title is read -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:centerColor="#40080810"
                android:endColor="#00080810"
                android:startColor="#E6080810" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:centerColor="#20080810"
                android:endColor="#00080810"
                android:startColor="#99080810" />
        </shape>
    </item>
</layer-list>
