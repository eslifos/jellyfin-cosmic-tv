<?xml version="1.0" encoding="utf-8"?>
<!-- The screensaver of the TV (dream/CosmicDreamService) -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/theme_background">

    <org.jellyfin.mobile.dream.CosmicBackgroundView
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ImageView
        android:id="@+id/dream_back"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <ImageView
        android:id="@+id/dream_front"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <View
        android:id="@+id/dream_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/dream_scrim" />

    <LinearLayout
        android:id="@+id/dream_clock_box"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="40dp"
        android:gravity="end"
        android:orientation="vertical">

        <TextClock
            android:id="@+id/dream_clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-light"
            android:shadowColor="#99000000"
            android:shadowRadius="12"
            android:textColor="@android:color/white"
            android:textSize="44sp" />

        <TextClock
            android:id="@+id/dream_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:shadowColor="#99000000"
            android:shadowRadius="10"
            android:textColor="#D9FFFFFF"
            android:textSize="16sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/dream_info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_margin="48dp"
        android:alpha="0"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/dream_logo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:importantForAccessibility="no"
            android:maxWidth="300dp"
            android:maxHeight="110dp"
            android:scaleType="fitStart" />

        <TextView
            android:id="@+id/dream_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="480dp"
            android:maxLines="2"
            android:shadowColor="#99000000"
            android:shadowRadius="12"
            android:textColor="@android:color/white"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/dream_year"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:shadowColor="#99000000"
            android:shadowRadius="10"
            android:textColor="#D9FFFFFF"
            android:textSize="16sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/dream_mark"
        android:layout_width="wrap_content"
        android:layout_height="28dp"
        android:layout_gravity="bottom|end"
        android:layout_margin="40dp"
        android:adjustViewBounds="true"
        android:alpha="0.75"
        android:importantForAccessibility="no"
        android:src="@drawable/app_logo" />
</FrameLayout>
